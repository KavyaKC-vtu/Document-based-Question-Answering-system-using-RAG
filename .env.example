# Groq API Configuration — DO NOT commit real keys to GitHub
# Get a free key at https://console.groq.com/keys

GROQ_API_KEY=your_groq_api_key_here
# Use a currently available Groq model. Check https://console.groq.com/docs/models
# Valid examples (verified 2026-08-29 via Groq API): openai/gpt-oss-120b, openai/gpt-oss-20b, allam-2-7b, groq/compound, groq/compound-mini, qwen/qwen3-32b
# NOTE: llama-3.1-8b-instant and mixtral-8x7b-32768 are now 404/decommissioned
GROQ_MODEL=openai/gpt-oss-120b

# Optional: override embedding model (default: all-MiniLM-L6-v2)
# EMBEDDING_MODEL=all-MiniLM-L6-v2
